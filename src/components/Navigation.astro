---
import {NAV_LINKS, SITE} from "../site.config.ts";
---
<div class="flex justify-center gap-8 my-4">
  {
    NAV_LINKS.map((link) => {
      return (
        <a href={link.href} class="hover:text-(--primary) font-bold text-xl transition uppercase">
          {link.name}
        </a>
      )
    })
  }
</div>