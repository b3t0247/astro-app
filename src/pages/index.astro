---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "John Doe";
---
<BaseLayout>
    <section class="mx-auto max-w-4xl px-4 py-16 text-center">
    <h1 class="mb-2 text-5xl font-bold tracking-tight">
        {pageTitle}
    </h1>
    <p class="mb-6 text-xl text-slate-500 dark:text-slate-400">
      IT Support Engineer • Software Engineer (AI/ML)
    </p>

    <p class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed">
      I’m a Technical Support Engineer and Software Developer focused on AI, machine learning,
      automation, and modern web technologies. I enjoy building practical tools, documenting what I learn,
      and sharing projects that bridge IT operations and software development.
    </p>

    <div class="flex justify-center gap-4">
      <a
        href="/blog"
        class="rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white transition hover:bg-blue-700"
      >
        Read My Blog
      </a>

      <a
        href="/about"
        class="rounded-lg border border-blue-600 px-6 py-3 font-semibold text-blue-600 transition hover:bg-blue-50"
      >
        About Me
      </a>
    </div>
  </section>
</BaseLayout>